---
interface Props {
  items: string[];
  label?: string;
}
const { items, label = 'Технологии' } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="tags" aria-label={label}>
      {items.map((t) => <li>{t}</li>)}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  li {
    font: var(--text-caption);
    padding: 3px 6px;
    border-radius: 4px;
    background: var(--color-tag);
  }
</style>
