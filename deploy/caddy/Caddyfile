# Домен приходит из переменной DOMAIN (deploy/.env → compose → контейнер).
# Сертификаты выпускаются только для перечисленных здесь хостов.

(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
}

{$DOMAIN} {
	import common

	# API формы нагрузки на том же домене, что и сайт: CORS не нужен.
	# handle_path срезает /loadgen/api, сервис видит /status, /run и т.д.
	# SSE (/run/{id}/events) Caddy проксирует без буферизации сам.
	handle_path /loadgen/api/* {
		reverse_proxy loadgen-web:8080
	}

	handle {
		root * /srv/site
		file_server
	}

	# Файлы Astro с хешем в имени можно кешировать навсегда.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# BookReviews. Само приложение ограничивает обложку 5 МБ, здесь запас на multipart.
books.{$DOMAIN} {
	import common
	request_body {
		max_size 6MB
	}
	reverse_proxy bookreviews:8000
}

# ПВЗ-сервис. Тела запросов — пара полей JSON, сервис сам ограничивает их 1 МБ.
pvz.{$DOMAIN} {
	import common
	request_body {
		max_size 1MB
	}
	reverse_proxy pvz:8080
}

# Фудграм. Картинки приходят base64 в JSON: файл до 5 МБ даёт тело около 7 МБ.
foodgram.{$DOMAIN} {
	import common
	request_body {
		max_size 10MB
	}
	reverse_proxy foodgram-gateway:80
}
