# Домен приходит из переменной DOMAIN (deploy/.env → compose → контейнер).
# Сертификаты выпускаются только для перечисленных здесь хостов.

(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
}

{$DOMAIN} {
	import common
	root * /srv/site
	file_server

	# Файлы Astro с хешем в имени можно кешировать навсегда.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
