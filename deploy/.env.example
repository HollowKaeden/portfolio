# На сервере скопировать в /opt/givemeanoffer/.env и заполнить.
# Пароли генерировать так: openssl rand -hex 24 (hex безопасен внутри DATABASE_URL).

# Основной домен; поддомены books., foodgram. строятся от него.
DOMAIN=givemeanoffer.ru

# Теги образов; latest по умолчанию, для отката можно указать sha коммита.
# PORTFOLIO_TAG=latest
# BOOKREVIEWS_TAG=latest

# Postgres: пароль суперпользователя postgres (приложениям не нужен).
POSTGRES_PASSWORD=

# BookReviews
BOOKREVIEWS_DB_PASSWORD=
BOOKREVIEWS_ADMIN_USERNAME=admin
BOOKREVIEWS_ADMIN_PASSWORD=

# Фудграм. Суперпользователь для /admin/ создаётся вручную после первого деплоя (см. CLAUDE.md).
# FOODGRAM_TAG=latest
# Образы Фудграма в Docker Hub: docker.io/<логин Docker Hub>
FOODGRAM_IMAGE_PREFIX=docker.io/
FOODGRAM_DB_PASSWORD=
FOODGRAM_SECRET_KEY=

# Бэкапы (backup.sh, restore-check.sh): restic → Yandex Object Storage.
# RESTIC_PASSWORD шифрует бэкап; копию хранить в менеджере паролей, без неё бэкап не восстановить.
RESTIC_PASSWORD=
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/<бакет>/restic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
